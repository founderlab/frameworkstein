{
  "name": "stein-fetch",
  "version": "11.7.4-beta.0",
  "description": "Fetch wrapper that allows requests to be built via chaining functions",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "author": {
    "name": "Gwilym Humphreys",
    "url": "https://github.com/gwilymhumphreys"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/founderlab/frameworkstein/tree/master/packages/stein-fetch"
  },
  "scripts": {
    "prepare": "tsc --project tsconfig.build.json",
    "build": "tsc --project tsconfig.build.json",
    "watch": "tsc --project tsconfig.build.json --watch",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "cross-fetch": "^3.0.0",
    "lodash": "^4.0.0",
    "qs": "^6.0.0"
  },
  "devDependencies": {},
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "verbose": true,
    "bail": true,
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "gitHead": "e1e1a50162bd4b054f52769c447e5abe76af1383"
}
