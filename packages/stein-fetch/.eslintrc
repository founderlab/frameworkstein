{
  "extends": "founderlab",
  "parser": "babel-eslint",
  "rules": {
    "strict": 0
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "extends": [
        "founderlab",
        "@typescript-eslint/recommended"
      ],
      "rules": {
        "strict": 0,
        "@typescript-eslint/no-explicit-any": "warn"
      }
    }
  ]
}
